# Copy to .env and adjust as needed - docker compose loads .env
# automatically from the project directory.

# Superuser created by initdb the first time root boots. Used both to
# connect while root is unlocked (unlock prints the full connection
# string) and as the owner of everything cloned into every branch.
# Change this before your first `docker compose up` if you don't want the
# default - it's baked into root at initdb time and won't change on its own
# afterwards.
PGBRANCH_SUPERUSER=postgres
PGBRANCH_SUPERUSER_PASSWORD=postgres

# Nominal size of the sparse btrfs loopback file. Sparse = costs nothing
# until actually written to; the real ceiling is always the host's actual
# free disk, not this number. Safe to leave high - see README FAQ.
PGBRANCH_IMG_SIZE=100G

# Fixed port root is published on while unlocked. Kept separate from the
# branch pool below so root never competes with a branch for a port.
PGBRANCH_ROOT_PORT=6999

# Pool `create` allocates branch ports from, one per branch. Must be wide
# enough for however many branches you plan to run at once.
PGBRANCH_PORT_MIN=7000
PGBRANCH_PORT_MAX=7050
